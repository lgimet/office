# Application
APP_ENV=dev
APP_DEBUG=true

# Base de données MySQL (à renseigner dans votre fichier .env local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=office
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Authentification JWT (générez une valeur secrète propre à chaque environnement)
JWT_SECRET=
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600
# Cookie d'accès partagé avec api.devsys.fr pour le consentement OAuth.
# Laisser vide en local si l'API n'est pas sur un sous-domaine Devsys.
AUTH_COOKIE_DOMAIN=.devsys.fr
# URL exacte autorisée après la connexion Office (protection anti open redirect).
OAUTH_AUTHORIZE_URL=https://api.devsys.fr/oauth/authorize

# API interne (jeton à envoyer avec Authorization: Bearer <valeur>)
API_INTERNAL_KEY=

# API métier Devsys (appelée exclusivement côté serveur)
DEVSYS_API_BASE_URL=https://api.devsys.fr/api/v1
DEVSYS_API_TIMEOUT=10
DEVSYS_API_CONNECT_TIMEOUT=5
DEVSYS_OAUTH_TOKEN_URL=https://api.devsys.fr/oauth/token
DEVSYS_API_CLIENT_ID=
DEVSYS_API_CLIENT_SECRET=
DEVSYS_API_SCOPE="read:clients write:clients"
