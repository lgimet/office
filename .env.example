# Application
APP_ENV=dev
APP_DEBUG=true

# Base de données MySQL (à renseigner dans votre fichier .env local)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=office
DB_USER=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# OpenID Connect — identité centralisée DevSys
OFFICE_OIDC_ISSUER=https://login.devsys.fr
OFFICE_OIDC_CLIENT_ID=office-web
OFFICE_OIDC_CLIENT_SECRET=
OFFICE_OIDC_REDIRECT_URI=https://office.devsys.fr/auth/oidc/callback
OFFICE_OIDC_SCOPES="openid profile email read:clients write:clients delete:clients read:invoices"
OFFICE_OIDC_RESOURCE=https://api.devsys.fr
OFFICE_OIDC_HTTP_TIMEOUT=10
OFFICE_OIDC_CONNECT_TIMEOUT=5
OFFICE_SESSION_COOKIE_NAME=office_session
OFFICE_SESSION_TTL=3600
OFFICE_CENTRAL_LOGOUT_URL=https://login.devsys.fr/auth/logout
OFFICE_CENTRAL_RP_LOGOUT_URL=https://login.devsys.fr/auth/logout/rp
OFFICE_POST_LOGOUT_REDIRECT_URI=https://office.devsys.fr/logged-out

# API interne (jeton à envoyer avec Authorization: Bearer <valeur>)
API_INTERNAL_KEY=

# API métier Devsys (appelée exclusivement côté serveur)
DEVSYS_API_BASE_URL=https://api.devsys.fr/api/v1
DEVSYS_API_TIMEOUT=10
DEVSYS_API_CONNECT_TIMEOUT=5

# Bascule explicite de la lecture de la liste des factures via shared/InvoicesApi
OFFICE_INVOICE_READ_API_ENABLED=false

# Bascule indépendante des écritures de brouillons via shared/InvoicesApi
# Ne pas activer avant validation des dépendances API/Office décrites dans docs/reports/OFFICE-UI-INV-2.md
OFFICE_INVOICE_DRAFT_WRITE_API_ENABLED=false

# Stockage privé des modèles PDF de factures (hors public/)
OFFICE_STORAGE_DIR=/var/lib/office

# Temporary Office operator-only API identity preflight; keep disabled by default.
OFFICE_INVOICE_PREFLIGHT_ENABLED=false
OFFICE_INVOICE_PREFLIGHT_OPERATOR_SUBJECT=
# Temporary diagnostic lease: canonical Unix seconds, <=300 seconds total.
# BOOT_ID binds the lease to this host boot; reboot invalidates it immediately.
OFFICE_INVOICE_PREFLIGHT_STARTED_AT=
OFFICE_INVOICE_PREFLIGHT_EXPIRES_AT=
OFFICE_INVOICE_PREFLIGHT_BOOT_ID=
