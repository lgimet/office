<section class="crm-page">
    <div class="crm-toolbar">
        <input id="clients-search" type="search" placeholder="Rechercher un client">
        <div id="clients-category-filter" class="select" data-url="/Clients/categories" data-mode="list" data-placeholder="Toutes les catégories" data-empty-label="Toutes les catégories"><input type="hidden" name="client_category" value=""></div>
        <div id="clients-legal-type-filter" class="select" data-url="/Clients/legalTypes" data-mode="list" data-placeholder="Tous les types juridiques" data-empty-label="Tous les types juridiques"><input type="hidden" name="legal_type" value=""></div>
    </div>
    <div id="clients-table" class="flex-table-container table-large" data-source="/Clients/data" data-limit="25" data-sort="updated_at" data-dir="desc" data-columns="client_name,client_category_name,legal_type_name,contact_name,email,phone,city,status,actions" data-widths="2fr 1fr 1.25fr 1.5fr 1.5fr 1fr 1fr 100px 64px">
        <div class="flex-table-header"><div class="cell left" data-sort="client_name">Client</div><div class="cell left" data-sort="client_category_name">Catégorie client</div><div class="cell left" data-sort="legal_type_name">Type juridique</div><div class="cell left">Contact</div><div class="cell left" data-sort="email">E-mail</div><div class="cell left">Téléphone</div><div class="cell left" data-sort="city">Ville</div><div class="cell" data-sort="status">Statut</div><div class="cell actions">Actions</div></div>
        <div class="flex-table-body"><div class="flex-row model" style="display:none"><div class="cell left"></div><div class="cell left"></div><div class="cell left"></div><div class="cell left"></div><div class="cell left"></div><div class="cell left"></div><div class="cell left"></div><div class="cell"></div><div class="cell actions"></div></div></div>
    </div>
</section>
