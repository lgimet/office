<aside class="sidebar">
    <!-- HEADER -->
    <div class="sidebar-header">
         <div class="brand">

        <!-- BRAND LOGO -->
        <img src="/assets/images/logo.png" alt="Logo O'Repas" class="brand-logo">

        <span class="brand-name">
            DevSys
        </span>

    </div>

    </div>
    <!-- NAVIGATION -->
    <nav class="sidebar-nav">
        <div class="nav-section">Navigation</div>
        {% for group in menuItems %}
                <div class="nav-group{% if group.open ?? false %} open{% endif %}">
                    <div class="nav-group-header d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="bi {{group.icon}}"></i>
                            <span>{{group.label}}</span>
                        </div>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </div>
                    <div class="nav-group-content">
                        {% for item in group.items %}
                        <button type="button" class="nav-item" data-action="{{item.action}}">
                            {% if item.icon ?? false %}<i class="bi {{item.icon}}"></i>{% endif %}
                            <span>{{item.label}}</span>
                        </button>
                        {% endfor %}  
                    </div>
                </div>
        {% endfor %}
    </nav>
</aside>
