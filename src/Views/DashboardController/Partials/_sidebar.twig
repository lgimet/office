<aside class="sidebar">
    <!-- HEADER -->
    <div class="sidebar-header">
         <div class="brand">

        <!-- BRAND LOGO -->
        <img src="/assets/images/LogoB.svg" alt="Logo O'Repas" class="brand-logo">

        <span class="brand-name">
            Brand Name
        </span>

    </div>

    </div>
    <!-- NAVIGATION -->
    <nav class="sidebar-nav">
        {% for group in menuItems %}
                <div class="nav-group">
                    <div class="nav-group-header d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="bi {{group.icon}}"></i>
                            <span>{{group.label}}</span>
                        </div>
                        <i class="bi bi-chevron-down toggle-icon"></i>
                    </div>
                    <div class="nav-group-content">
                        {% for item in group.items %}
                        <div class="nav-item" data-action="{{item.action}}">
                            <span>{{item.label}}</span>
                        </div>  
                        {% endfor %}  
                    </div>
                </div>
        {% endfor %}
    </nav>
</aside>