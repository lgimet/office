<section class="invoice-editor">
    {% set default_issue_date = invoice.issue_date|default(today) %}
    {% set default_due_date = invoice.due_date|default('') %}
    {% set default_payment_terms = invoice.payment_terms|default(defaults.payment_terms|default('Sous 15 jours')) %}
    {% set default_payment_terms_code = invoice.payment_terms_code|default(defaults.payment_terms_code|default('')) %}
    {% set selected_terms_code = default_payment_terms_code %}
    {% if selected_terms_code not in ['cash', 'receipt', 'days_15', 'days_30', 'days_45', 'days_60', 'days_30_then_eom', 'days_45_then_eom', 'custom'] %}
        {% set selected_terms_code = '' %}
    {% endif %}
    {% if not selected_terms_code %}
        {% set normalized_terms = default_payment_terms|lower|trim %}
        {% if normalized_terms in ['cash', 'comptant'] %}{% set selected_terms_code = 'cash' %}
        {% elseif normalized_terms in ['receipt', 'à réception', 'a réception', 'a reception'] %}{% set selected_terms_code = 'receipt' %}
        {% elseif normalized_terms in ['days_15', '15 jours', 'sous 15 jours'] %}{% set selected_terms_code = 'days_15' %}
        {% elseif normalized_terms in ['days_30', '30 jours', '30 jours date de facture', 'sous 30 jours'] %}{% set selected_terms_code = 'days_30' %}
        {% elseif normalized_terms in ['days_45', '45 jours'] %}{% set selected_terms_code = 'days_45' %}
        {% elseif normalized_terms in ['days_60', '60 jours'] %}{% set selected_terms_code = 'days_60' %}
        {% elseif normalized_terms in ['days_30_then_eom', '30 jours fin de mois', '30 jours puis fin de mois'] %}{% set selected_terms_code = 'days_30_then_eom' %}
        {% elseif normalized_terms in ['days_45_then_eom', '45 jours fin de mois', '45 jours puis fin de mois'] %}{% set selected_terms_code = 'days_45_then_eom' %}
        {% else %}{% set selected_terms_code = 'custom' %}
        {% endif %}
    {% endif %}
    <header class="invoice-editor__header">
        <div class="invoice-header__main">
            <div class="invoice-header__icon" aria-hidden="true">
                <span class="material-symbols-outlined">receipt_long</span>
            </div>
            <div class="invoice-header__identity">
                <div class="invoice-header__title-row">
                    <h2>
                        {% if invoice and invoice.invoice_number %}
                            Facture {{ invoice.invoice_number }}
                        {% elseif invoice %}
                            Modifier la facture
                        {% else %}
                            Nouvelle facture
                        {% endif %}
                    </h2>
                    <span class="invoice-status invoice-status--draft">Brouillon</span>
                </div>
                <p>
                    {% if invoice and invoice.client_name %}
                        {{ invoice.client_name }}
                    {% elseif invoice %}
                        Modifiez votre brouillon avant validation.
                    {% else %}
                        Créez et préparez votre facture avant validation.
                    {% endif %}
                </p>
            </div>
        </div>
        <div class="invoice-header__meta">
            {% if invoice and invoice.issue_date %}
                <span>Émise le <strong>{{ invoice.issue_date|date('d/m/Y') }}</strong></span>
            {% elseif today %}
                <span>Date <strong>{{ today|date('d/m/Y') }}</strong></span>
            {% endif %}
            {% if invoice and invoice.due_date %}
                <span>Échéance le <strong>{{ invoice.due_date|date('d/m/Y') }}</strong></span>
            {% endif %}
        </div>
    </header>

    <form
        id="invoice-form"
        class="invoice-form"
        data-default-tax-rate="{{ defaults.tax_rate ?? '20.00' }}"
        data-existing-invoice="{{ invoice ? '1' : '0' }}"
    >
        <input type="hidden" name="id" value="{{ invoice.id ?? '' }}">

        <section class="invoice-card">
            <h3><span class="material-symbols-outlined" aria-hidden="true">person</span> Client et informations</h3>

            <div class="invoice-card-columns">
                <div class="invoice-client-column">
                    <div class="form-field invoice-client-field">
                        <div
                            id="invoice-client"
                            class="select"
                            data-url="/Invoices/clientOptions"
                            data-mode="search"
                            data-placeholder="Rechercher un client"
                            data-selected-label="{{ invoice.client_name ?? '' }}"
                        >
                            <input type="hidden" name="client_id" required value="{{ invoice.client_id ?? '' }}">
                        </div>
                        <label for="invoice-client">Client</label>
                    </div>

                    <div class="invoice-client-details" aria-live="polite">
                        <div class="invoice-readonly-field">
                            <span>Adresse</span>
                            <output id="invoice-client-address">{{ invoice.client_address_line1 ?? '' }}{% if invoice.client_address_line2 %}, {{ invoice.client_address_line2 }}{% endif %}</output>
                        </div>
                        <div class="invoice-readonly-field">
                            <span>Code postal</span>
                            <output id="invoice-client-postal-code">{{ invoice.client_postal_code ?? '' }}</output>
                        </div>
                        <div class="invoice-readonly-field">
                            <span>Ville</span>
                            <output id="invoice-client-city">{{ invoice.client_city ?? '' }}</output>
                        </div>
                        <div class="invoice-readonly-field">
                            <span>Téléphone</span>
                            <output id="invoice-client-phone">{{ invoice.client_phone ?? '' }}</output>
                        </div>
                        <div class="invoice-readonly-field">
                            <span>E-mail</span>
                            <output><a id="invoice-client-email" href="{% if invoice.client_email %}mailto:{{ invoice.client_email }}{% endif %}">{{ invoice.client_email ?? '' }}</a></output>
                        </div>
                    </div>
                </div>

                <div class="invoice-details-column">
                    <div class="form-field invoice-details-field">
                        <input
                            id="invoice-issue-date"
                            type="date"
                            name="issue_date"
                            value="{{ default_issue_date }}"
                            required
                        >
                        <label for="invoice-issue-date">Date de facture</label>
                    </div>

                    <div class="form-field invoice-details-field">
                        <input
                            id="invoice-due-date"
                            type="date"
                            name="due_date"
                            value="{{ default_due_date }}"
                        >
                        <label for="invoice-due-date">Date d’échéance</label>
                    </div>

                    <div class="form-field invoice-details-field invoice-payment-terms-field">
                        <select id="invoice-payment-terms-preset" aria-describedby="invoice-payment-terms-custom-label">
                            <option value="cash" data-label="Comptant" {% if selected_terms_code == 'cash' %}selected{% endif %}>Comptant</option>
                            <option value="receipt" data-label="À réception" {% if selected_terms_code == 'receipt' %}selected{% endif %}>À réception</option>
                            <option value="days_15" data-label="15 jours" {% if selected_terms_code == 'days_15' %}selected{% endif %}>15 jours</option>
                            <option value="days_30" data-label="30 jours" {% if selected_terms_code == 'days_30' %}selected{% endif %}>30 jours</option>
                            <option value="days_45" data-label="45 jours" {% if selected_terms_code == 'days_45' %}selected{% endif %}>45 jours</option>
                            <option value="days_60" data-label="60 jours" {% if selected_terms_code == 'days_60' %}selected{% endif %}>60 jours</option>
                            <option value="days_30_then_eom" data-label="30 jours fin de mois" {% if selected_terms_code == 'days_30_then_eom' %}selected{% endif %}>30 jours fin de mois</option>
                            <option value="days_45_then_eom" data-label="45 jours fin de mois" {% if selected_terms_code == 'days_45_then_eom' %}selected{% endif %}>45 jours fin de mois</option>
                            <option value="custom" data-label="Personnalisé" {% if selected_terms_code == 'custom' %}selected{% endif %}>Personnalisé</option>
                        </select>
                        <input id="invoice-payment-terms-code" type="hidden" name="payment_terms_code" value="{{ default_payment_terms_code }}">
                        <input id="invoice-payment-terms" type="hidden" name="payment_terms" value="{{ default_payment_terms }}">
                        <div class="invoice-payment-terms-custom" hidden>
                            <label id="invoice-payment-terms-custom-label" for="invoice-payment-terms-custom-input">Libellé du délai personnalisé</label>
                            <input id="invoice-payment-terms-custom-input" type="text" value="{{ default_payment_terms }}" placeholder="Ex. Selon contrat">
                        </div>
                        <label for="invoice-payment-terms-preset">Délai de paiement</label>
                    </div>

                    <div class="form-field invoice-details-field">
                        <select id="invoice-payment-method" name="payment_method">
                            {% set payment_method = invoice.payment_method|default(defaults.payment_method|default('CB')) %}
                            <option value="CB" {% if payment_method == 'CB' %}selected{% endif %}>CB</option>
                            <option value="Chèque" {% if payment_method == 'Chèque' %}selected{% endif %}>Chèque</option>
                            <option value="Virement" {% if payment_method == 'Virement' %}selected{% endif %}>Virement</option>
                        </select>
                        <label for="invoice-payment-method">Mode de paiement attendu</label>
                    </div>

                    <div class="form-field invoice-details-field">
                        <input id="invoice-currency" name="currency" value="{{ invoice.currency ?? defaults.currency ?? 'EUR' }}" readonly>
                        <label for="invoice-currency">Devise</label>
                    </div>
                </div>
            </div>
        </section>

        <div class="invoice-layout">
            <section class="invoice-card">
                <h3><span class="material-symbols-outlined" aria-hidden="true">format_list_bulleted</span> Lignes de facture</h3>

                <div class="invoice-lines-head">
                    <span>#</span>
                    <span>Désignation</span>
                    <span>Description</span>
                    <span>Qté</span>
                    <span>Unité</span>
                    <span>Prix HT</span>
                    <span>TVA</span>
                    <span>Total HT</span>
                    <span></span>
                </div>

                <div id="invoice-lines">
                    {% for line in lines %}
                        <div class="invoice-line-row">
                            <div class="invoice-line">
                                <span class="line-position">{{ loop.index }}</span>
                                <input name="label" placeholder="Désignation" value="{{ line.label }}">
                                <input name="description" placeholder="Description" value="{{ line.description ?? '' }}">
                                <input name="quantity" type="number" min="0.001" step="0.001" value="{{ line.quantity }}">
                                <select name="unit">
                                    {% for unit in ['unité', 'heure', 'jour', 'forfait', 'mois'] %}
                                        <option value="{{ unit }}" {% if line.unit == unit %}selected{% endif %}>{{ unit }}</option>
                                    {% endfor %}
                                </select>
                                <input name="unit_price_excl_tax" type="number" min="0" step="0.01" value="{{ line.unit_price_excl_tax }}">
                                <input name="tax_rate" type="number" min="0" step="0.01" value="{{ line.tax_rate }}">
                                <strong class="line-total">{{ line.line_subtotal_excl_tax|number_format(2, ',', ' ') }} €</strong>
                                <div class="line-actions">
                                    <button type="button" class="invoice-discount-toggle">+ Remise</button>
                                    <button type="button" class="invoice-line-delete" aria-label="Supprimer cette ligne">×</button>
                                </div>
                            </div>

                            <div class="invoice-discount" {% if not line.discount_type %}hidden{% endif %}>
                                <span class="invoice-discount__title">Remise</span>
                                <label>
                                    <span>Type</span>
                                    <select name="discount_type">
                                        <option value="" {% if not line.discount_type %}selected{% endif %}>Aucune remise</option>
                                        <option value="percentage" {% if line.discount_type == 'percentage' %}selected{% endif %}>Pourcentage</option>
                                        <option value="fixed" {% if line.discount_type == 'fixed' %}selected{% endif %}>Montant fixe</option>
                                    </select>
                                </label>
                                <label>
                                    <span>Valeur</span>
                                    <div class="invoice-discount__value">
                                        <input name="discount_value" type="number" min="0" step="0.01" value="{{ line.discount_value ?? '0.00' }}">
                                        <span class="discount-suffix">{% if line.discount_type == 'percentage' %}%{% else %}€{% endif %}</span>
                                    </div>
                                </label>
                                <label class="invoice-discount__comment">
                                    <span>Commentaire de remise</span>
                                    <input name="discount_note" maxlength="255" value="{{ line.discount_note ?? '' }}" placeholder="Ex. geste commercial">
                                </label>
                                <span class="invoice-discount__amount">
                                    Montant déduit : <strong class="line-discount-amount">{{ line.line_discount_excl_tax|default(0)|number_format(2, ',', ' ') }} €</strong>
                                </span>
                                <button type="button" class="invoice-discount-remove">Retirer la remise</button>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <button id="add-invoice-line" type="button" class="m-btn m-btn--outline">
                    ＋ Ajouter une ligne
                </button>

                <hr>

                <h3><span class="material-symbols-outlined" aria-hidden="true">article</span> Notes</h3>

                <div class="invoice-grid invoice-notes">
                    <div class="form-field">
                        <textarea id="invoice-public-note" name="public_note" placeholder="">{{ invoice.public_note ?? '' }}</textarea>
                        <label for="invoice-public-note">Note visible sur la facture</label>
                    </div>

                    <div class="form-field">
                        <textarea id="invoice-internal-note" name="internal_note" placeholder="">{{ invoice.internal_note ?? '' }}</textarea>
                        <label for="invoice-internal-note">Note interne</label>
                    </div>
                </div>
            </section>

            <aside class="invoice-summary">
                <h3>Récapitulatif</h3>
                <p id="invoice-summary-subtotal" hidden>Sous-total HT <strong id="invoice-total-subtotal">0,00 €</strong></p>
                <p id="invoice-summary-discount" hidden>Remises <strong id="invoice-total-discount">-0,00 €</strong></p>
                <p>Total HT <strong id="invoice-total-ht">0,00 €</strong></p>
                <p>TVA <strong id="invoice-total-tax">0,00 €</strong></p>
                <hr>
                <p class="invoice-summary__total">Total TTC <strong id="invoice-total-ttc">0,00 €</strong></p>
                <div class="invoice-summary__hint">ⓘ Les montants sont recalculés automatiquement.</div>
            </aside>
        </div>
    </form>
</section>
